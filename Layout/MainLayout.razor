@using LTSaveEd.Models
@using System.Diagnostics
@using System.Xml.Linq
@using LTSaveEd.Models.Enums
@using LTSaveEd.Models.JSWrappers
@using LTSaveEd.Components
@using LTSaveEd.Models.CharacterExporter

@inherits LayoutComponentBase

@inject ISnackbar Snackbar
@inject ApplicationState ApplicationState
@inject FileHandler FileHandler
@inject Settings Settings
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

<MudThemeProvider @bind-IsDarkMode="@IsDarkMode" Theme="@_theme"/>
<MudSnackbarProvider/>
<MudDialogProvider/>
<MudPopoverProvider/>

<MudLayout>
    <MudAppBar Elevation="0" Class="app-bar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(_ => DrawerToggle())"/>
        <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="2" Class="ml-2">
            <MudText Typo="Typo.h6" Class="app-title">LTSaveEd</MudText>
            <MudText Typo="Typo.caption" Class="app-version">@Version</MudText>
        </MudStack>
        <MudIconButton Icon="@(IsDarkMode ? Icons.Material.Outlined.DarkMode : Icons.Material.Outlined.LightMode)"
                       Color="Color.Inherit" Class="ml-2" OnClick="@ToggleTheme"/>
        <MudSpacer/>
        @switch (ApplicationState.Location)
        {
            case ApplicationStateLocation.SaveEditor:
                @FilenameField()
                @LoadButton(LoadSave)
                @SaveButton(SaveFile, _currentState == EditorState.Saving || !SaveData.Initialized)
                break;
            case ApplicationStateLocation.ModEditor:
                @LoadButton(LoadMod)
                @SaveButton(SaveMod, _currentState == EditorState.Saving)
                break;
            case ApplicationStateLocation.ModEditorHome:
                break;
            case ApplicationStateLocation.CharacterExporter:
                @FilenameField()
                @LoadButton(LoadExport)
                @SaveButton(SaveExport, _currentState == EditorState.Saving)
                break;
            default:
                Console.WriteLine("Unknown ApplicationStateLocation: " + ApplicationState.Location);
                break;
        }
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" AriaLabel="Open menu" Class="ml-2">
            @switch (ApplicationState.Location)
            {
                case ApplicationStateLocation.SaveEditor:
                    <MudMenuItem Label="Switch to Mod Editor" Icon="@Icons.Material.Outlined.Palette" OnClick="SwitchToModEditor"/>
                    <MudMenuItem Label="Switch to Export Editor" Icon="@Icons.Material.Outlined.IosShare" OnClick="SwitchToExportEditor"/>
                    break;
                case ApplicationStateLocation.ModEditor:
                case ApplicationStateLocation.ModEditorHome:
                    <MudMenuItem Label="Switch to Save Editor" Icon="@Icons.Material.Outlined.Save" OnClick="SwitchToSaveEditor"/>
                    <MudMenuItem Label="Switch to Export Editor" Icon="@Icons.Material.Outlined.IosShare" OnClick="SwitchToExportEditor"/>
                    break;
                case ApplicationStateLocation.CharacterExporter:
                    <MudMenuItem Label="Switch to Save Editor" Icon="@Icons.Material.Outlined.Save" OnClick="SwitchToSaveEditor"/>
                    <MudMenuItem Label="Switch to Mod Editor" Icon="@Icons.Material.Outlined.Palette" OnClick="SwitchToModEditor"/>
                    break;
                default:
                    Console.WriteLine("Unknown ApplicationStateLocation: " + ApplicationState.Location);
                    break;
            }
        </MudMenu>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Class="app-drawer">
        <MudPaper Width="100%" Elevation="0" Class="py-3 px-2" Style="background: transparent;">
            <MudNavMenu Color="Color.Primary" Rounded="true" Margin="Margin.Dense">
                @switch (ApplicationState.Location)
                {
                    case ApplicationStateLocation.SaveEditor:
                        <MudNavLink Href="core" Icon="@Icons.Material.Outlined.Person">Core</MudNavLink>
                        <MudNavLink Href="attributes" Icon="@Icons.Material.Outlined.Tune">Attributes</MudNavLink>
                        <MudNavGroup Title="Body" Icon="@Icons.Material.Outlined.Accessibility">
                            <MudNavLink Href="body/bodycore">Body Core</MudNavLink>
                            <MudNavLink Href="body/head">Head</MudNavLink>
                            <MudNavLink Href="body/face">Face</MudNavLink>
                            <MudNavLink Href="body/breasts">Breasts</MudNavLink>
                            <MudNavLink Href="body/breastscrotch">Breasts Crotch</MudNavLink>
                            <MudNavLink Href="body/torso">Torso</MudNavLink>
                            <MudNavLink Href="body/penis">Penis</MudNavLink>
                            <MudNavLink Href="body/vagina">Vagina</MudNavLink>
                            <MudNavLink Href="body/ass">Ass</MudNavLink>
                        </MudNavGroup>
                        <MudNavLink Href="fetishes" Icon="@Icons.Material.Outlined.FavoriteBorder">Fetishes</MudNavLink>
                        <MudNavLink Href="perks" Icon="@Icons.Material.Outlined.StarBorder">Perks</MudNavLink>
                        <MudNavGroup Title="Spells" Icon="@Icons.Material.Outlined.AutoFixHigh">
                            <MudNavLink Href="spells/earth">Earth</MudNavLink>
                            <MudNavLink Href="spells/water">Water</MudNavLink>
                            <MudNavLink Href="spells/fire">Fire</MudNavLink>
                            <MudNavLink Href="spells/air">Air</MudNavLink>
                            <MudNavLink Href="spells/arcane">Arcane</MudNavLink>
                            <MudNavLink Href="spells/misc">Misc</MudNavLink>
                        </MudNavGroup>
                        <MudNavGroup Title="Inventory" Icon="@Icons.Material.Outlined.Inventory2">
                            <MudNavLink Href="inventory/items">Items</MudNavLink>
                            <MudNavLink Href="inventory/clothing">Clothing</MudNavLink>
                            <MudNavLink Href="inventory/weapons">Weapons</MudNavLink>
                            <MudNavLink Href="inventory/equipped" Disabled="true">Equipped</MudNavLink>
                        </MudNavGroup>
                        <MudNavLink Href="relationships" Icon="@Icons.Material.Outlined.People">Relationships</MudNavLink>
                        <MudNavLink Href="family" Icon="@Icons.Material.Outlined.FamilyRestroom">Family</MudNavLink>
                        <MudNavLink Href="offsprings" Icon="@Icons.Material.Outlined.ChildCare">Offsprings</MudNavLink>
                        <MudNavLink Href="world" Icon="@Icons.Material.Outlined.Public">World</MudNavLink>
                        <MudNavLink Href="extra" Icon="@Icons.Material.Outlined.MoreHoriz">Extra</MudNavLink>
                        break;
                    case ApplicationStateLocation.ModEditor or ApplicationStateLocation.ModEditorHome:
                        <MudNavLink Href="mod-editor/color" Icon="@Icons.Material.Outlined.Palette">Color</MudNavLink>
                        <MudNavLink Href="mod-editor/clothing" Icon="@Icons.Material.Outlined.Checkroom">Clothing</MudNavLink>
                        break;
                    case ApplicationStateLocation.CharacterExporter:
                        <MudNavLink Href="character-exporter/core" Icon="@Icons.Material.Outlined.Person">Core</MudNavLink>
                        <MudNavLink Href="character-exporter/attributes" Icon="@Icons.Material.Outlined.Tune">Attributes</MudNavLink>
                        <MudNavGroup Title="Body" Icon="@Icons.Material.Outlined.Accessibility">
                            <MudNavLink Href="character-exporter/body/bodycore">Body Core</MudNavLink>
                            <MudNavLink Href="character-exporter/body/head">Head</MudNavLink>
                            <MudNavLink Href="character-exporter/body/face">Face</MudNavLink>
                            <MudNavLink Href="character-exporter/body/breasts">Breasts</MudNavLink>
                            <MudNavLink Href="character-exporter/body/breastscrotch">Breasts Crotch</MudNavLink>
                            <MudNavLink Href="character-exporter/body/torso">Torso</MudNavLink>
                            <MudNavLink Href="character-exporter/body/penis">Penis</MudNavLink>
                            <MudNavLink Href="character-exporter/body/vagina">Vagina</MudNavLink>
                            <MudNavLink Href="character-exporter/body/ass">Ass</MudNavLink>
                        </MudNavGroup>
                        <MudNavLink Href="character-exporter/fetishes" Icon="@Icons.Material.Outlined.FavoriteBorder">Fetishes</MudNavLink>
                        <MudNavLink Href="character-exporter/perks" Icon="@Icons.Material.Outlined.StarBorder">Perks</MudNavLink>
                        <MudNavGroup Title="Spells" Icon="@Icons.Material.Outlined.AutoFixHigh">
                            <MudNavLink Href="character-exporter/spells/earth">Earth</MudNavLink>
                            <MudNavLink Href="character-exporter/spells/water">Water</MudNavLink>
                            <MudNavLink Href="character-exporter/spells/fire">Fire</MudNavLink>
                            <MudNavLink Href="character-exporter/spells/air">Air</MudNavLink>
                            <MudNavLink Href="character-exporter/spells/arcane">Arcane</MudNavLink>
                            <MudNavLink Href="character-exporter/spells/misc">Misc</MudNavLink>
                        </MudNavGroup>
                        <MudNavGroup Title="Inventory" Icon="@Icons.Material.Outlined.Inventory2">
                            <MudNavLink Href="character-exporter/inventory/items">Items</MudNavLink>
                            <MudNavLink Href="character-exporter/inventory/clothing">Clothing</MudNavLink>
                            <MudNavLink Href="character-exporter/inventory/weapons">Weapons</MudNavLink>
                            <MudNavLink Href="character-exporter/inventory/equipped" Disabled="true">Equipped</MudNavLink>
                        </MudNavGroup>
                        @* <MudNavLink Href="character-exporter/relationships">Relationships</MudNavLink> *@
                        <MudNavLink Href="character-exporter/family" Icon="@Icons.Material.Outlined.FamilyRestroom">Family</MudNavLink>
                        break;
                    default:
                        Console.WriteLine("Unknown ApplicationStateLocation: " + ApplicationState.Location);
                        break;
                }
            </MudNavMenu>
        </MudPaper>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="app-content">
            @if (_currentState == EditorState.Loading)
            {
                <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="mt-16">
                    <MudProgressCircular Size="Size.Large" Indeterminate="true"/>
                    <MudText Typo="Typo.subtitle1" Color="Color.Default">Loading file...</MudText>
                </MudStack>
            }
            else
            {
                <ErrorBoundary>
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent>
                        <ErrorMessageElement CurrentException="context"/>
                    </ErrorContent>
                </ErrorBoundary>
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {

    // Make sure to also update .csproj file with the correct version
    private const string Version = "v2.10.0";

    private bool _drawerOpen;
    private EditorState _currentState = EditorState.Idle;
    private ApplicationStateLocation _prevLocation = ApplicationStateLocation.SaveEditor;

    private readonly MudTheme _theme = AppTheme.Theme;
    private string Filename { get; set; } = "";

    private bool IsDarkMode
    {
        get => Settings.DarkMode;
        set => Settings.DarkMode = value;
    }

    private SaveData SaveData => ApplicationState.SaveData;
    private ExportEditor ExportEditor => ApplicationState.ExportEditor;

    // ---------- Shared app bar fragments (previously copy-pasted per location) ----------

    private RenderFragment FilenameField() => @<MudTextField @bind-Value="@Filename" ReadOnly="true"
                                                            Variant="Variant.Outlined" Margin="Margin.Dense"
                                                            Placeholder="No file loaded" Adornment="Adornment.Start"
                                                            AdornmentIcon="@Icons.Material.Outlined.Description"
                                                            Class="filename-field mr-3"/>;

    private RenderFragment LoadButton(Func<IBrowserFile?, Task> onFileChosen) =>
        @<MudFileUpload T="IBrowserFile" Accept=".xml" FilesChanged="@(file => onFileChosen(file))">
            <CustomContent>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           OnClick="@context.OpenFilePickerAsync"
                           StartIcon="@Icons.Material.Filled.CloudUpload">
                    Load
                </MudButton>
            </CustomContent>
            <SelectedTemplate/>
        </MudFileUpload>;

    private RenderFragment SaveButton(Func<Task> onSave, bool disabled) =>
        @<MudButton Disabled="@disabled" OnClick="@(() => onSave())" Variant="Variant.Filled" Color="Color.Secondary"
                    StartIcon="@(_currentState == EditorState.Saving ? null : Icons.Material.Filled.Save)" Class="ml-2">
            @if (_currentState == EditorState.Saving)
            {
                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true"/>
                <span>Processing</span>
            }
            else
            {
                <span>Save</span>
            }
        </MudButton>;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _prevLocation = ApplicationState.Location;
        ApplicationState.LocationChanged += OnStateChanged;
    }

    /// <summary>
    ///     Toggles the drawer open/closed
    /// </summary>
    private void DrawerToggle()
    {
        // Prevent toggling the drawer if the save data is not initialized and we are in the Save Editor location
        if (!SaveData.Initialized && ApplicationState.Location == ApplicationStateLocation.SaveEditor)
        {
            return;
        }

        _drawerOpen = !_drawerOpen;
        StateHasChanged();
    }

    /// <summary>
    ///    Loads the save data from the file
    /// </summary>
    private async Task LoadSave(IBrowserFile? file)
    {
        if (file == null)
        {
            return;
        }

        _currentState = EditorState.Loading;
        await Task.Delay(100);
        var oldName = Filename;
        Filename = file.Name;
        await using var stream = file.OpenReadStream(file.Size + 1);
        var stopwatch = new Stopwatch();
        stopwatch.Start();
        var errorMessage = await SaveData.Initialize(stream);
        stopwatch.Stop();
        Console.WriteLine($"Loaded Save in {stopwatch.ElapsedMilliseconds} ms");
        StateHasChanged();
        Snackbar.Clear();
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        if (errorMessage is null)
        {
            Snackbar.Add("Save Data Loaded!", Severity.Success);
        }
        else
        {
            Snackbar.Add($"Failed to Load Data! Reason: {errorMessage}", Severity.Error);
            Filename = oldName;
        }

        _currentState = EditorState.Idle;
    }

    /// <summary>
    ///    Saves the save data to a file
    /// </summary>
    private async Task SaveFile()
    {
        _currentState = EditorState.Saving;
        await Task.Delay(250);

        try
        {
            var memoryStream = new MemoryStream();
            await SaveData.SaveDataXml.SaveAsync(memoryStream, SaveOptions.None, CancellationToken.None);

            var byteArray = memoryStream.ToArray();

            await FileHandler.DownloadFileFromByteArrayAsync(byteArray, Filename);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving file: {ex.Message}");
        }
        finally
        {
            _currentState = EditorState.Idle;
        }
    }

    private async Task LoadMod(IBrowserFile? file)
    {
        if (file == null)
        {
            return;
        }

        // Changing the view to show loading icon reloads the page's state, so we don't change _currentState here otherwise
        // it causes the page to lose the loaded mod data
        //_currentState = EditorState.Loading;
        await Task.Delay(100);
        var oldName = Filename;
        Filename = file.Name;
        await using var stream = file.OpenReadStream(file.Size + 1);
        var stopwatch = new Stopwatch();
        stopwatch.Start();
        var success = await ApplicationState.LoadMod(stream);
        stopwatch.Stop();
        Console.WriteLine($"Loaded Mod in {stopwatch.ElapsedMilliseconds} ms");
        StateHasChanged();
        Snackbar.Clear();
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        if (success)
        {
            Snackbar.Add("Mod Data Loaded!", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to Load Mod!", Severity.Error);
            Filename = oldName;
        }

        _currentState = EditorState.Idle;
    }

    private async Task SaveMod()
    {
        _currentState = EditorState.Saving;
        await Task.Delay(250);

        try
        {
            var memoryStream = await ApplicationState.SaveMod();
            var byteArray = memoryStream.ToArray();
            await FileHandler.DownloadFileFromByteArrayAsync(byteArray, Filename);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving file: {ex.Message}");
        }
        finally
        {
            _currentState = EditorState.Idle;
        }
    }

    private async Task LoadExport(IBrowserFile? file)
    {
        if (file == null)
        {
            return;
        }

        _currentState = EditorState.Loading;
        await Task.Delay(100);
        var oldName = Filename;
        Filename = file.Name;
        await using var stream = file.OpenReadStream(file.Size + 1);
        var stopwatch = new Stopwatch();
        stopwatch.Start();
        var success = await ExportEditor.Load(stream);
        stopwatch.Stop();
        Console.WriteLine($"Loaded Export in {stopwatch.ElapsedMilliseconds} ms");
        StateHasChanged();
        Snackbar.Clear();
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        if (success)
        {
            Snackbar.Add("Exported Character Loaded!", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to Load Exported Character!", Severity.Error);
            Filename = oldName;
        }

        _currentState = EditorState.Idle;
    }

    private async Task SaveExport()
    {
        _currentState = EditorState.Saving;
        await Task.Delay(250);

        try
        {
            var memoryStream = new MemoryStream();
            await ExportEditor.ExportedCharacterXml.SaveAsync(memoryStream, SaveOptions.None, CancellationToken.None);

            var byteArray = memoryStream.ToArray();

            await FileHandler.DownloadFileFromByteArrayAsync(byteArray, Filename);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving file: {ex.Message}");
        }
        finally
        {
            _currentState = EditorState.Idle;
        }
    }

    /// <summary>
    ///   Toggles the theme between light and dark
    /// </summary>
    private void ToggleTheme()
    {
        IsDarkMode = !IsDarkMode;
        StateHasChanged();
    }

    private void OnStateChanged()
    {
        var currentLocation = ApplicationState.Location;
        if (currentLocation != _prevLocation
            && (currentLocation is not (ApplicationStateLocation.ModEditor or ApplicationStateLocation.ModEditorHome)
                && _prevLocation is not (ApplicationStateLocation.ModEditor or ApplicationStateLocation.ModEditorHome)))
        {
            // Moving from mod editor to mod editor home or vice versa does not close the drawer
            _drawerOpen = false;
        }

        StateHasChanged();
    }

    private enum EditorState
    {
        Idle,
        Loading,
        Saving
    }

    private void SwitchToModEditor()
    {
        NavigationManager.NavigateTo("mod-editor");
    }

    private void SwitchToSaveEditor()
    {
        NavigationManager.NavigateTo("home");
    }

    private void SwitchToExportEditor()
    {
        NavigationManager.NavigateTo("character-exporter");
    }

}
