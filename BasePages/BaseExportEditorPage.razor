@using LTSaveEd.Models
@using LTSaveEd.Models.CharacterExporter

@inject NavigationManager NavigationManager
@inject ApplicationState ApplicationState

@code {
    protected ExportEditor ExportEditor => ApplicationState.ExportEditor;
    
    protected override void OnInitialized()
    {
        ApplicationState.UpdateLocation(NavigationManager);
        if (!ExportEditor.Initialized)
        {
            NavigationManager.NavigateTo("character-exporter/home", replace: true);
        }
    }
}